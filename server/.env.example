# Configurações do Servidor
PORT=3001
NODE_ENV=production

# Conexão com o PostgreSQL fornecida pelo Railway (DATABASE_URL)
# No Railway, essa variável é preenchida automaticamente ao adicionar o PostgreSQL
DATABASE_URL=postgresql://postgres:senha@monorail.proxy.rlwy.net:12345/railway

# Chave secreta para assinatura dos tokens JWT (use uma string forte e aleatória em produção)
JWT_SECRET=sua_chave_secreta_jwt_longa_e_aleatoria_aqui
JWT_EXPIRES_IN=7d

# CORS (domínios permitidos do Frontend / Cloudflare Pages)
CLIENT_URL=https://dedetizadoramaringa.com.br,https://ddd-maringa-site.pages.dev,http://localhost:5173
